# قاعدة البيانات: PostgreSQL في كل البيئات (انظر docs/DEPLOYMENT.md)
# DATABASE_URL للتشغيل (يقبل رابط المجمِّع pooler)، وDATABASE_URL_UNPOOLED للترحيلات (اتصال مباشر، اختياري).
# على Vercel مع Neon يُضبطان تلقائياً عند ربط قاعدة البيانات بالمشروع.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shaaer"
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/shaaer"

# العنوان العام للمنصة: تُبنى منه روابط رموز QR
APP_URL="http://localhost:3010"

# مفتاح توقيع الجلسات: 32 حرفاً عشوائياً على الأقل، ويرفض الخادم العمل دونه في الإنتاج
SESSION_SECRET="change-me-to-a-long-random-string-please"

# التحقق المؤقت بالبريد (المادة 62): يُستبدل بالنفاذ الوطني قبل الإطلاق العام.
# لا مزود بريد بعد، فيُسجَّل الرمز في سجل الخادم دائماً، ويظهر على الشاشة:
# - في التطوير فقط بـ AUTH_DEV_SHOW_CODE
# - في نسخة عرض منشورة بـ AUTH_DEMO_SHOW_CODE (أي أحد يدخل بأي بريد: لبيانات تجريبية فقط)
AUTH_DEV_SHOW_CODE="true"
AUTH_DEMO_SHOW_CODE="false"

# البيانات التجريبية: تُنشأ تلقائياً خارج الإنتاج، وفي الإنتاج فقط بـ SEED_DEMO=true
SEED_DEMO="false"

# حجز مبالغ العقود: "escrow" حجز فعلي، أو "record" توثيق فقط (المادة 35، السؤال ب1)
ESCROW_MODE="record"
